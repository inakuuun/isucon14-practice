# Tables
#    SHOW TABLE STATUS FROM `isuride` LIKE 'chairs'\G
#    SHOW CREATE TABLE `isuride`.`chairs`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'LATERAL'\G
#    SHOW CREATE TABLE `isuride`.`LATERAL`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'chair_locations'\G
#    SHOW CREATE TABLE `isuride`.`chair_locations`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'rides'\G
#    SHOW CREATE TABLE `isuride`.`rides`\G
#    SHOW TABLE STATUS FROM `isuride` LIKE 'ride_statuses'\G
#    SHOW CREATE TABLE `isuride`.`ride_statuses`\G
# EXPLAIN /*!50100 PARTITIONS*/
SELECT chairs.id, chairs.name, chairs.model, latest_location.latitude, latest_location.longitude
FROM chairs
       JOIN LATERAL (SELECT latitude, longitude
                     FROM chair_locations
                     WHERE chair_locations.chair_id = chairs.id
                     ORDER BY created_at DESC
                     LIMIT 1) latest_location ON TRUE
WHERE chairs.is_active = TRUE
  AND ABS(latest_location.latitude - 324) + ABS(latest_location.longitude - 334) <= 50
  AND NOT EXISTS (SELECT 1
                  FROM rides
                  WHERE rides.chair_id = chairs.id
                    AND (SELECT status FROM ride_statuses WHERE ride_statuses.ride_id = rides.id ORDER BY created_at DESC LIMIT 1) <> 'COMPLETED')
ORDER BY chairs.id\G

